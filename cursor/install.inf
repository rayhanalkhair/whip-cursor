; Right-click -> Install. Adds a "Whip Cursor" pointer scheme (copies into C:\Windows\Cursors, so UAC asks).
[Version]
signature="$CHICAGO$"

[DefaultInstall]
CopyFiles = Scheme.Cur
AddReg    = Scheme.Reg

[DestinationDirs]
Scheme.Cur = 10,"%CUR_DIR%"

[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",,"%10%\%CUR_DIR%\%pointer%,,,,,,,,,,,,,,,,"
HKCU,"Control Panel\Cursors",,0x00020000,"%SCHEME_NAME%"
HKCU,"Control Panel\Cursors",Arrow,0x00020000,"%10%\%CUR_DIR%\%pointer%"

[Scheme.Cur]
whip-handle.cur

[Strings]
CUR_DIR     = "Cursors\Whip Cursor"
SCHEME_NAME = "Whip Cursor"
pointer     = "whip-handle.cur"
